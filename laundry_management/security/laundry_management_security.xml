<?xml version="1.0" ?>
<odoo>
    <data noupdate="1">
        <!-- Module Category for Laundry Management -->
        <record id="module_category_laundry" model="ir.module.category">
            <field name="name">Laundry Management</field>
            <field name="sequence">18</field>
        </record>

        <!-- Privilege Definition for Laundry Management -->
        <record model="res.groups.privilege" id="res_groups_privilege_laundry_management">
            <field name="name">Laundry Management</field>
            <field name="description">Complete access to laundry service management features</field>
            <field name="category_id" ref="laundry_management.module_category_laundry"/>
            <field name="sequence">25</field>
        </record>

        <!-- User Group - Basic access to laundry features -->
        <record id="group_laundry_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_laundry_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Basic access to laundry management features. Can create and manage their own laundry orders.</field>
        </record>

        <!-- Manager Group - Full access to all laundry features -->
        <record id="group_laundry_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_laundry_management"/>
            <field name="implied_ids" eval="[(4, ref('laundry_management.group_laundry_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full access to all laundry management features including configuration and all orders.</field>
        </record>

        <!-- Record Rules for Laundry Orders -->
        <record id="laundry_order_user_rule" model="ir.rule">
            <field name="name">Laundry User: Own orders only</field>
            <field name="model_id" ref="model_laundry_order"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('laundry_management.group_laundry_user'))]"/>
        </record>

        <record id="laundry_order_manager_rule" model="ir.rule">
            <field name="name">Laundry Manager: Full access</field>
            <field name="model_id" ref="model_laundry_order"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('laundry_management.group_laundry_manager'))]"/>
        </record>

        <!-- Record Rules for Laundry Pickup Requests -->
        <record id="laundry_pickup_request_user_rule" model="ir.rule">
            <field name="name">Laundry User: Own pickup requests only</field>
            <field name="model_id" ref="model_laundry_pickup_request"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('laundry_management.group_laundry_user'))]"/>
        </record>

        <record id="laundry_pickup_request_manager_rule" model="ir.rule">
            <field name="name">Laundry Manager: All pickup requests</field>
            <field name="model_id" ref="model_laundry_pickup_request"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('laundry_management.group_laundry_manager'))]"/>
        </record>

        <!-- Record Rules for Laundry Contract -->
        <record id="laundry_contract_public_rule" model="ir.rule">
            <field name="name">Laundry Contract: Public Create</field>
            <field name="model_id" ref="model_laundry_contract"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('base.group_public'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="laundry_contract_portal_rule" model="ir.rule">
            <field name="name">Laundry Contract: Portal Own Contracts</field>
            <field name="model_id" ref="model_laundry_contract"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="laundry_order_portal_rule" model="ir.rule">
            <field name="name">Laundry Order: Portal Own Orders</field>
            <field name="model_id" ref="model_laundry_order"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

    </data>
</odoo>
