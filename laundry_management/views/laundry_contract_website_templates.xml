<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="laundry_contract_form_template" name="Laundry Contract Form">
        <t t-call="website.layout">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <h2 class="mt-4 mb-4">Book Laundry Contract</h2>
                        <form action="/laundry/contract/submit" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <div class="form-group mb-3">
                                <label for="name" class="form-label">Name</label>
                                <input type="text" class="form-control" name="name" required="required" t-att-value="request.env.user.partner_id.name if not request.env.user._is_public() else ''"/>
                            </div>

                            <div class="form-group mb-3">
                                <label for="mobile" class="form-label">Mobile No</label>
                                <input type="text" class="form-control" name="mobile" required="required" t-att-value="request.env.user.partner_id.phone if not request.env.user._is_public() else ''"/>
                            </div>

                            <div class="form-group mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" name="email" t-att-value="request.env.user.partner_id.email if not request.env.user._is_public() else ''"/>
                            </div>

                            <div class="form-group mb-3">
                                <label for="business_type" class="form-label">Business Type</label>
                                <select class="form-control" name="business_type" required="required">
                                    <option value="">Select Business Type</option>
                                    <option value="hotel">Hotel</option>
                                    <option value="restaurant">Restaurant</option>
                                    <option value="hostel">Hostel</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>

                            <div class="form-group mb-3">
                                <label for="description" class="form-label">Description</label>
                                <textarea class="form-control" name="description" rows="4"></textarea>
                            </div>

                            <div class="form-group mb-3">
                                <button type="submit" class="btn btn-primary">Submit</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="laundry_contract_success_template" name="Laundry Contract Success">
        <t t-call="website.layout">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <div class="alert alert-success mt-5" role="alert">
                            <h4 class="alert-heading">Success!</h4>
                            <p>Your laundry contract request has been submitted successfully.</p>
                            <hr/>
                            <p class="mb-0">We will contact you shortly.</p>
                        </div>
                        <a href="/" class="btn btn-secondary mt-3">Back to Home</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <record id="menu_laundry_contract_website" model="website.menu">
        <field name="name">Book Contract</field>
        <field name="url">/laundry/contract</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">50</field>
    </record>
</odoo>
