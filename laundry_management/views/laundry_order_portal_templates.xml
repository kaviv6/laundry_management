<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_laundry" name="Portal layout : laundry menu" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'laundry_order'" class="breadcrumb-item active">
                Laundry Orders
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_laundry" name="Show Laundry Orders" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div class="o_portal_index_card col-12 col-md-6">
                <a href="/my/laundry/orders" title="Laundry Orders" class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div class="o_portal_icon d-block align-self-start">
                        <img src="/laundry_management/static/description/order.png" style="width: 4rem; height: auto;" alt="Laundry Orders"/>
                    </div>
                    <div>
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1 d-flex gap-2">
                            <t t-out="laundry_order_count"/>
                            <span t-if="not laundry_order_count" class="d-none" data-placeholder_count="laundry_order_count"/>
                            Laundry Orders
                        </div>
                    </div>
                </a>
            </div>
        </xpath>
    </template>

    <template id="portal_my_laundry_orders" name="My Laundry Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Laundry Orders</t>
            </t>
            <t t-if="not laundry_orders">
                <p>There are currently no laundry orders for your account.</p>
            </t>
            <t t-if="laundry_orders" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Order Reference</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="laundry_orders" t-as="order">
                        <tr>
                            <td>
                                <a t-att-href="order.get_portal_url()"><span t-field="order.name"/></a>
                            </td>
                            <td><span t-field="order.order_date"/></td>
                            <td><span t-field="order.state"/></td>
                            <td><span t-field="order.total_amount" t-options='{"widget": "monetary"}'/></td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>
</odoo>
