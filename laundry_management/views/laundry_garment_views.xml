<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="laundry_garment_list_view" model="ir.ui.view">
        <field name="name">laundry.garment.list</field>
        <field name="model">laundry.garment</field>
        <field name="arch" type="xml">
            <list string="Garments" decoration-success="state == 'ready'"
                  decoration-info="state == 'cleaning'"
                  decoration-muted="state == 'delivered'">
                <field name="barcode"/>
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="service_type_id"/>
                <field name="qty"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'ready'"
                       decoration-warning="state == 'cleaning'"
                       decoration-info="state == 'received'"
                       decoration-muted="state == 'delivered'"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="laundry_garment_form_view" model="ir.ui.view">
        <field name="name">laundry.garment.form</field>
        <field name="model">laundry.garment</field>
        <field name="arch" type="xml">
            <form string="Garment">
                <header>
                    <button name="action_cleaning" string="Start Cleaning"
                            type="object" class="oe_highlight"
                            invisible="state != 'received'"
                            groups="laundry_management.group_laundry_manager,laundry_management.group_laundry_user"/>
                    <button name="action_ready" string="Mark Ready"
                            type="object" class="oe_highlight"
                            invisible="state != 'cleaning'"
                            groups="laundry_management.group_laundry_manager,laundry_management.group_laundry_user"/>
                    <button name="action_delivered" string="Mark Delivered"
                            type="object"
                            invisible="state != 'ready'"
                            groups="laundry_management.group_laundry_manager,laundry_management.group_laundry_rider"/>
                    <button name="action_print_label" string="Print Label"
                            type="object" icon="fa-print"
                            groups="laundry_management.group_laundry_manager,laundry_management.group_laundry_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,cleaning,ready,delivered"/>
                </header>
                <sheet>
                    <group>
                        <group string="Garment Info">
                            <field name="name" readonly="1"/>
                            <field name="barcode" readonly="1"/>
                            <field name="order_id"/>
                            <field name="service_type_id"/>
                            <field name="qty"/>
                        </group>
                        <group string="Customer">
                            <field name="partner_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Additional notes about this garment..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban view for wash status board -->
    <record id="laundry_garment_kanban_view" model="ir.ui.view">
        <field name="name">laundry.garment.kanban</field>
        <field name="model">laundry.garment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="barcode"/>
                <field name="partner_id"/>
                <field name="service_type_id"/>
                <field name="order_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <strong><field name="barcode"/></strong>
                            <div class="text-muted"><field name="partner_id"/></div>
                            <div><field name="service_type_id"/> × <field name="qty"/></div>
                            <div class="text-muted small"><field name="order_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view -->
    <record id="laundry_garment_search_view" model="ir.ui.view">
        <field name="name">laundry.garment.search</field>
        <field name="model">laundry.garment</field>
        <field name="arch" type="xml">
            <search string="Garments">
                <field name="barcode" string="Barcode" filter_domain="[('barcode', '=', self)]"/>
                <field name="partner_id" string="Customer"/>
                <field name="order_id" string="Order"/>
                <separator/>
                <filter name="received" string="Received" domain="[('state', '=', 'received')]"/>
                <filter name="cleaning" string="In Cleaning" domain="[('state', '=', 'cleaning')]"/>
                <filter name="ready" string="Ready" domain="[('state', '=', 'ready')]"/>
                <filter name="delivered" string="Delivered" domain="[('state', '=', 'delivered')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_service" string="Service Type" context="{'group_by': 'service_type_id'}"/>
                    <filter name="group_order" string="Order" context="{'group_by': 'order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_laundry_garment" model="ir.actions.act_window">
        <field name="name">Garments</field>
        <field name="res_model">laundry.garment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="laundry_garment_search_view"/>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_laundry_garment"
              name="Garments"
              parent="laundry_management.laundry_management_menu"
              action="action_laundry_garment"
              sequence="30"
              groups="laundry_management.group_laundry_manager,laundry_management.group_laundry_user"/>

</odoo>
