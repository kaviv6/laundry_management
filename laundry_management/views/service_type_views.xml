<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Washing type model form view -->
    <record id="service_type_form_view" model="ir.ui.view">
        <field name="name">service.type.view.form</field>
        <field name="model">service.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="assigned_person_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Washing type model list view -->
    <record id="service_type_view_list" model="ir.ui.view">
        <field name="name">service.type.view.list</field>
        <field name="model">service.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="assigned_person_id"/>
                <field name="amount"/>
            </list>
        </field>
    </record>
    <!--    Action for washing type-->
    <record id="service_type_action" model="ir.actions.act_window">
        <field name="name">Service Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">service.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <!--    Defined Menus-->
    <menuitem id="laundry_customer" name="Customers"
              parent="laundry_management.laundry_management_menu"
              action="base.action_partner_customer_form" sequence="50"
              groups="laundry_management.group_laundry_manager"/>
    <!-- Products/Service Types live under the single "Configuration" tab
         defined in laundry_service_zone_views.xml (loaded before this file —
         see __manifest__.py) alongside Pricelists/Service Zones/Settings,
         instead of a second, differently-named Configuration menu. -->
    <menuitem id="laundry_products" name="Products"
              parent="laundry_management.menu_laundry_configuration"
              action="product.product_normal_action_sell" sequence="10"/>
    <menuitem id="laundry_service_type" name="Service Types"
              parent="laundry_management.menu_laundry_configuration" action="service_type_action"
              sequence="20"/>
</odoo>
