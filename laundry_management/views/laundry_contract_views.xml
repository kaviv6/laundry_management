<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_contract_form" model="ir.ui.view">
        <field name="name">laundry.contract.form</field>
        <field name="model">laundry.contract</field>
        <field name="arch" type="xml">
            <form string="Laundry Contract" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="mobile" readonly="1"/>
                            <field name="email" readonly="1"/>
                        </group>
                        <group>
                            <field name="business_type" readonly="1"/>
                            <field name="description" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_laundry_contract_tree" model="ir.ui.view">
        <field name="name">laundry.contract.tree</field>
        <field name="model">laundry.contract</field>
        <field name="arch" type="xml">
            <list string="Laundry Contracts" create="false" edit="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="business_type"/>
            </list>
        </field>
    </record>

    <record id="action_laundry_contract" model="ir.actions.act_window">
        <field name="name">Laundry Contracts</field>
        <field name="res_model">laundry.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_laundry_contract"
              name="Contracts"
              parent="laundry_management.laundry_management_sub_menu"
              action="action_laundry_contract"
              sequence="20"/>
</odoo>
