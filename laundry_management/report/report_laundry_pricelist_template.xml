<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_laundry_pricelist_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span>Pricelist:</span>
                            <span t-field="doc.name"/>
                        </h2>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Service Type</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.pricelist_item_ids" t-as="item">
                                    <td>
                                        <span t-field="item.product_id.name"/>
                                    </td>
                                    <td>
                                        <span t-field="item.service_type_id.name"/>
                                    </td>
                                    <td>
                                        <span t-field="item.price"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
