        ============================================================ -->

        <!-- Order 1: Rahul — Draft — COD -->
        <record id="demo_order_rahul_001" model="laundry.order">
            <field name="partner_id" ref="partner_rahul_sharma"/>
            <field name="laundry_person_id" ref="base.user_root"/>
            <field name="rider_id" ref="user_vikram_rider"/>
            <field name="payment_method">cod</field>
            <field name="state">draft</field>
            <field name="note">Handle with care — silk shirts included.</field>
        </record>
        <record id="demo_order_line_r1_1" model="laundry.order.line">
            <field name="laundry_id" ref="demo_order_rahul_001"/>
            <field name="product_id" ref="product_product_laundry_service"/>
            <field name="service_type_id" ref="service_type_normal_wash"/>
