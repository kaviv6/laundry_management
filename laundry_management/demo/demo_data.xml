             PICKUP REQUESTS
        ============================================================ -->

        <!-- Pickup 1: Rahul — Scheduled, assigned to Vikram -->
        <record id="demo_pickup_rahul_001" model="laundry.pickup.request">
            <field name="partner_id" ref="partner_rahul_sharma"/>
            <field name="laundry_person_id" ref="user_vikram_rider"/>
            <field name="schedule_date" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 10:00:00')"/>
            <field name="payment_method">cod</field>
            <field name="state">scheduled</field>
        </record>
        <record id="demo_pickup_line_r1_1" model="laundry.pickup.request.line">
            <field name="request_id" ref="demo_pickup_rahul_001"/>
            <field name="product_id" ref="product_product_laundry_service"/>
