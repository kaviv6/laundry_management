            <field name="laundry_person_id" ref="user_vikram_rider"/>
            <field name="schedule_date" eval="(DateTime.now() - relativedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="pickup_date" eval="(DateTime.now() - relativedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="payment_method">online</field>
            <field name="order_id" ref="demo_order_priya_001"/>
            <field name="state">picked</field>
        </record>
        <record id="demo_pickup_line_p1_1" model="laundry.pickup.request.line">
            <field name="request_id" ref="demo_pickup_priya_001"/>
            <field name="product_id" ref="product_product_laundry_service"/>
