<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_cashfree" model="ir.ui.view">
        <field name="name">CashFree Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group name="cashfree_credentials"
                       invisible="code != 'cashfree'">
                    <field name="cashfree_client_id"
                           string="Client Id"
                           required="code == 'cashfree' and state != 'disabled'"/>
                    <field name="cashfree_client_secret"
                           string="Client Secret"
                           required="code == 'cashfree' and state != 'disabled'"
                           password="True"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
